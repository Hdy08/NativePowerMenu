<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">原生电源菜单</string>
    <string name="module_description">把 ColorOS / Oplus 的电源菜单替换回原生 Android (AOSP) 样式，并可扩展引导模式 / 恢复模式，仅对 SystemUI 生效。</string>

    <!-- Extended power menu entries -->
    <string name="reboot_bootloader_title">引导模式</string>
    <string name="reboot_bootloader_confirm">确定要重启到引导模式（Bootloader）吗？\n重启后需要用音量键操作，长按电源键可退出。</string>
    <string name="reboot_recovery_title">恢复模式</string>
    <string name="reboot_recovery_confirm">确定要重启到恢复模式（Recovery）吗？</string>
    <string name="reboot_confirm_ok">确定</string>
    <string name="reboot_confirm_cancel">取消</string>
    <string name="reboot_unavailable">无法重启：请在 LSPosed 里把本模块的作用域加上「系统框架」</string>
</resources>
